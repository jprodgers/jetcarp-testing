<< {"id":4,"jsonrpc":"2.0","result":{"content":[{"text":"{\n  \"$id\": \"jetcarp://schema/search_start/hunt\",\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"description\": \"Small random soups on an unbounded plane, each run until it settles. Every object is classed, and new patterns are verified and stored; B/S and Generations rules without B0, on any periodic tiling; ships that fly away are cut out. Thousands of soups a second for Life.\",\n  \"properties\": {\n    \"density\": {\n      \"description\": \"Soup density (default 0.5).\",\n      \"type\": \"number\"\n    },\n    \"gens\": {\n      \"description\": \"Generations before a soup that has not settled is censused as it is (default 20,000).\",\n      \"minimum\": 0,\n      \"type\": \"integer\"\n    },\n    \"margin\": {\n      \"description\": \"Empty margin around the soup before escaping ships are cut (default 0: automatic).\",\n      \"minimum\": 0,\n      \"type\": \"integer\"\n    },\n    \"max_period\": {\n      \"description\": \"Longest period looked for (default 64).\",\n      \"minimum\": 0,\n      \"type\": \"integer\"\n    },\n    \"max_rss_gb\": {\n      \"description\": \"Stop, paused and resumable, when the process uses more memory than this many GB (checked before each batch of soups, as an explore search does).\",\n      \"type\": \"number\"\n    },\n    \"nb\": {\n      \"description\": \"Neighbourhood for every rule: touch or edge (default: the notation decides).\",\n      \"type\": \"string\"\n    },\n    \"pop_cap\": {\n      \"description\": \"Live cells above which a soup counts as exploded (default 0: automatic).\",\n      \"minimum\": 0,\n      \"type\": \"integer\"\n    },\n    \"rules\": {\n      \"description\": \"Rules (B/S and Generations without B0; a `V` suffix means edge neighbours): a list, or text separated by spaces, commas, or semicolons (default B3/S23).\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"type\": [\n        \"array\",\n        \"string\"\n      ]\n    },\n    \"rules_file\": {\n      \"description\": \"A file of more rules, one per line (`#` comments).\",\n      \"type\": \"string\"\n    },\n    \"seed\": {\n      \"description\": \"Soup i uses an RNG state from (seed, i) (default 1).\",\n      \"minimum\": 0,\n      \"pattern\": \"^[0-9]+$\",\n      \"type\": [\n        \"integer\",\n        \"string\"\n      ]\n    },\n    \"shape\": {\n      \"description\": \"Soup shape: rect (default) or disc.\",\n      \"type\": \"string\"\n    },\n    \"size\": {\n      \"description\": \"Soup size in unit cells: \\\"WxH\\\", n, or [w, h] (default 16x16).\",\n      \"items\": {\n        \"type\": \"integer\"\n      },\n      \"type\": [\n        \"array\",\n        \"integer\",\n        \"string\"\n      ]\n    },\n    \"soups\": {\n      \"description\": \"Soups per rule and tiling (default 10,000; 0: until stopped).\",\n      \"minimum\": 0,\n      \"type\": \"int ...[681 more chars cut in this log]
